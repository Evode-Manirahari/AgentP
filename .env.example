AGENTPDF_API_KEY=local-dev-key
AGENTPDF_DATABASE_URL=postgresql+psycopg://agentpdf:local-password@postgres:5432/agentpdf
AGENTPDF_REDIS_URL=redis://redis:6379/0
AGENTPDF_S3_ENDPOINT_URL=http://minio:9000
AGENTPDF_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AGENTPDF_S3_ACCESS_KEY_ID=agentpdf
AGENTPDF_S3_SECRET_ACCESS_KEY=agentpdf-secret
AGENTPDF_S3_BUCKET=agentpdf
AGENTPDF_MAX_UPLOAD_BYTES=52428800
AGENTPDF_MAX_PAGES=500
# Allow webhook deliveries to private, loopback, or link-local targets. Development only.
AGENTPDF_WEBHOOK_ALLOW_PRIVATE_URLS=false
# Purge documents older than this many days when the retention sweep runs.
# Unset means documents are kept until deleted explicitly.
# AGENTPDF_DOCUMENT_RETENTION_DAYS=30
